<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KeyboardDemo.PrismUnity</RootNamespace>
    <AssemblyName>WpfInput</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
  </ItemGroup>

  <!-- WPF-specific files — excluded until migrated to WinUI 3 -->
  <ItemGroup>
    <Compile Remove="Services\KeyboardInputService.cs" />
    <Compile Remove="Services\TextBoxInputTarget.cs" />
    <Page Remove="Views\KeyboardDemoView.xaml" />
    <Compile Remove="Views\KeyboardDemoView.xaml.cs" />
    <Page Remove="Views\OnScreenKeyboardView.xaml" />
    <Compile Remove="Views\OnScreenKeyboardView.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
