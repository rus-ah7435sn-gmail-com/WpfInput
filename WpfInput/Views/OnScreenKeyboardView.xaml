<UserControl
    x:Class="KeyboardDemo.PrismUnity.Views.OnScreenKeyboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="320" Width="400">

    <UserControl.Resources>
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="LightYellow"/>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" Background="#FF1E1E1E" Padding="10">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="KeyboardModeStates">
                    <VisualState x:Name="NumericMode">
                        <VisualState.Setters>
                            <Setter Target="NumericGrid.Visibility" Value="Visible"/>
                            <Setter Target="FullKeyboardGrid.Visibility" Value="Collapsed"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="FullMode">
                        <VisualState.Setters>
                            <Setter Target="NumericGrid.Visibility" Value="Collapsed"/>
                            <Setter Target="FullKeyboardGrid.Visibility" Value="Visible"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Numeric pad -->
            <Grid x:Name="NumericGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="OK" Style="{StaticResource KeyBtn}"
                        Background="Green" Foreground="White"
                        Command="{Binding PressKeyCommand}" CommandParameter="ENTER"/>

                <!-- Row 0 -->
                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="7"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="9"/>

                <!-- Row 1 -->
                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="6"/>

                <!-- Row 2 -->
                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="1"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="3"/>
                <Button Grid.Row="2" Grid.Column="3" Content="Esc" Style="{StaticResource KeyBtn}"
                        Background="LightGray"
                        Command="{Binding PressKeyCommand}" CommandParameter="ESC"/>

                <!-- Row 3 -->
                <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="0"/>
                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="00" Style="{StaticResource KeyBtn}"
                        Command="{Binding PressKeyCommand}" CommandParameter="00"/>
                <Button Grid.Row="3" Grid.Column="3" Content="⌫" Style="{StaticResource KeyBtn}"
                        Background="Red" Foreground="Black"
                        Command="{Binding PressKeyCommand}" CommandParameter="BACK"/>
            </Grid>

            <!-- Full keyboard -->
            <Grid x:Name="FullKeyboardGrid" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Row 0: Q W E R T Y U I O P -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Q" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="Q"/>
                    <Button Grid.Column="1" Content="W" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="W"/>
                    <Button Grid.Column="2" Content="E" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="E"/>
                    <Button Grid.Column="3" Content="R" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="R"/>
                    <Button Grid.Column="4" Content="T" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="T"/>
                    <Button Grid.Column="5" Content="Y" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="Y"/>
                    <Button Grid.Column="6" Content="U" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="U"/>
                    <Button Grid.Column="7" Content="I" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="I"/>
                    <Button Grid.Column="8" Content="O" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="O"/>
                    <Button Grid.Column="9" Content="P" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="P"/>
                </Grid>

                <!-- Row 1: A S D F G H J K L ⌫ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="A" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="A"/>
                    <Button Grid.Column="1" Content="S" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="S"/>
                    <Button Grid.Column="2" Content="D" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="D"/>
                    <Button Grid.Column="3" Content="F" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="F"/>
                    <Button Grid.Column="4" Content="G" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="G"/>
                    <Button Grid.Column="5" Content="H" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="H"/>
                    <Button Grid.Column="6" Content="J" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="J"/>
                    <Button Grid.Column="7" Content="K" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="K"/>
                    <Button Grid.Column="8" Content="L" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="L"/>
                    <Button Grid.Column="9" Content="⌫" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="BACK"/>
                </Grid>

                <!-- Row 2: Z X C V B N M - , Paste -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Z" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="Z"/>
                    <Button Grid.Column="1" Content="X" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="X"/>
                    <Button Grid.Column="2" Content="C" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="C"/>
                    <Button Grid.Column="3" Content="V" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="V"/>
                    <Button Grid.Column="4" Content="B" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="B"/>
                    <Button Grid.Column="5" Content="N" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="N"/>
                    <Button Grid.Column="6" Content="M" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="M"/>
                    <Button Grid.Column="7" Content="-" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="-"/>
                    <Button Grid.Column="8" Content="," Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter=","/>
                    <Button Grid.Column="9" Content="Paste" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="PASTE"/>
                </Grid>

                <!-- Row 3: Space Clear . -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Space" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter=" "/>
                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="CLEAR"/>
                    <Button Grid.Column="2" Content="." Style="{StaticResource KeyBtn}" Command="{Binding PressKeyCommand}" CommandParameter="."/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
