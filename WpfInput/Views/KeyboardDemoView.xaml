<UserControl x:Class="KeyboardDemo.PrismUnity.Views.KeyboardDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KeyboardDemo.PrismUnity.Views">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0"
                  Content="Input in Text1/Text2 only digital"
                  IsChecked="{Binding IsNumericOnly}"
                  Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Text1:" VerticalAlignment="Center"/>
            <TextBox x:Name="Text1Box" Grid.Column="1"
                     Text="{Binding Text1}"
                     IsReadOnly="True"
                     Height="34"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Text2:" VerticalAlignment="Center"/>
            <TextBox x:Name="Text2Box" Grid.Column="1"
                     Text="{Binding Text2}"
                     IsReadOnly="True"
                     Height="34"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Text3 (scanner/hardware input here when focus is not in Text1/Text2):" Margin="0,0,0,6"/>
            <TextBox x:Name="Text3Box" Grid.Row="1"
                     Text="{Binding Text3}"
                     IsReadOnly="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"/>
        </Grid>

        <Popup x:Name="KeyboardPopup" IsLightDismissEnabled="False">
            <views:OnScreenKeyboardView x:Name="KeyboardView"
                                       IsNumericOnly="{Binding IsNumericOnly}"/>
        </Popup>

        <TextBox x:Name="InputSink"
                 Width="1" Height="1"
                 Opacity="0"
                 IsTabStop="False"
                 IsReadOnly="True"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
